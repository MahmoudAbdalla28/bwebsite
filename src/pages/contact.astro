---
import Base from '../layouts/Base.astro'
---

<Base
  title="Talk to us · Bastion"
  description="Tell us what you are shipping and we will come back with what we would go after and what the record would show."
>
  <section class="section">
    <div class="page wrap">
      <div class="intro">
        <p class="label">Talk to us</p>
        <h1>Tell us what you are shipping.</h1>
        <p class="lede">
          We will come back with what we would attack, how long it takes, and
          what the report will contain.
        </p>
      </div>

      <p class="oops" id="oops" hidden>
        That did not send. Email team@trybastion.ai directly and we will pick it up.
      </p>

      <form
        class="form"
        action="https://bastion-contact.vercel.app/api/contact"
        method="POST"
      >
        <input
          type="text"
          name="_honey"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <label>
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label>
          <span>Work email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>Company</span>
          <input type="text" name="company" autocomplete="organization" />
        </label>

        <label>
          <span>Domain</span>
          <input type="text" name="domain" id="domain" autocomplete="off" spellcheck="false" />
        </label>

        <label>
          <span>What are you shipping?</span>
          <textarea
            name="agent"
            rows="4"
            placeholder="What the agent does, what it can reach, who uses it."></textarea>
        </label>

        <button class="btn btn-primary" type="submit">Send</button>
      </form>
    </div>
  </section>

  <script is:inline>
    // the hero asks for a domain and hands it over here, so carry it across
    const q = new URLSearchParams(location.search)
    const d = q.get('domain')
    if (d) document.getElementById('domain').value = d
    if (q.get('error')) document.getElementById('oops').hidden = false
  </script>
</Base>

<style>
  .wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.25rem, 6vw, 5rem);
    align-items: start;
  }

  h1 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.1rem);
    margin-block: 1.1rem 1.4rem;
    max-width: 14ch;
  }

  .form {
    display: grid;
    gap: 1.15rem;
    background: var(--bone-lift);
    border: 1px solid var(--stone-line);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  label {
    display: grid;
    gap: 0.45rem;
  }

  label span {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  textarea {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--ink);
    background: var(--bone);
    border: 1px solid var(--stone-line);
    border-radius: 2px;
    padding: 0.7rem 0.8rem;
    width: 100%;
    transition: border-color 150ms ease;
  }

  input:focus,
  textarea:focus {
    border-color: var(--gold);
  }

  textarea {
    resize: vertical;
  }

  .oops {
    margin-bottom: 1rem;
    padding: 0.8rem 1rem;
    font-size: 0.92rem;
    color: var(--ink);
    border: 1px solid #b4632a;
    border-left-width: 3px;
    border-radius: 3px;
    background: rgba(180, 99, 42, 0.12);
  }

  button {
    justify-self: start;
    cursor: pointer;
    font-family: var(--sans);
    margin-top: 0.35rem;
  }

  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
