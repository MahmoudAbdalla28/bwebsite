---
import Base from '../layouts/Base.astro'
---

<Base
  title="Received · Bastion"
  description="We have your request and will come back with a scope."
>
  <section class="section">
    <div class="page">
      <p class="label">Received</p>
      <h1>We have it.</h1>
      <p class="lede">
        We will come back with what we would attack, how long it takes, and what
        the report will contain.
      </p>
      <a class="btn btn-ghost" href="/">Back to the site</a>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.1rem);
    margin-block: 1.1rem 1.4rem;
  }
  .btn {
    margin-top: 2rem;
  }
</style>
