---
import { dataset } from '../data/dataset'

const security = [
  'Data leaks',
  'Prompt injection',
  'Tool abuse',
  'Cross-tenant access',
]

const reliability = [
  'Wrong action taken',
  'Off-policy behavior',
  'Instruction drift under pressure',
  'Confident, incorrect output',
]

const properties = [
  {
    term: 'Independent',
    def: 'We are not the vendor being assessed, and not the buyer. The result is not a self-report.',
  },
  {
    term: 'Compounding',
    def: 'Every engagement writes back. The next one starts from everything the last one learned.',
  },
  {
    term: 'Cross-customer',
    def: 'Failure patterns move between deployments. Yours are checked against everyone else’s.',
  },
]
---

<section class="section" id="how-agents-fail">
  <div class="page">
    <p class="label">How agents fail</p>

    <h2>
      Every way an agent can fail, security or reliability, becomes structured
      knowledge.
    </h2>

    <div class="columns">
      <div class="col">
        <h3>Security failures</h3>
        <ul>{security.map((s) => <li>{s}</li>)}</ul>
      </div>

      <div class="col">
        <h3>Reliability failures</h3>
        <ul>{reliability.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>

    <p class="one-dataset">One dataset. Not two products.</p>

    <dl class="properties">
      {
        properties.map((p) => (
          <div class="property">
            <dt>{p.term}</dt>
            <dd>{p.def}</dd>
          </div>
        ))
      }
    </dl>

    <p class="counts muted tnum">
      <span>{dataset.engagements} engagements</span>
      <span>{dataset.findings} recorded findings</span>
      <span>{dataset.lessons} lessons carried forward</span>
    </p>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.85rem, 1.2rem + 2.5vw, 3rem);
    max-width: 30ch;
    margin-block: 1.1rem clamp(2.75rem, 6vw, 4.5rem);
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 5vw, 4.5rem);
  }

  .col {
    border-top: 1px solid var(--stone-line);
    padding-top: 1.35rem;
  }

  .col h3 {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  li {
    font-family: var(--display);
    font-variation-settings: 'opsz' 24, 'SOFT' 12;
    font-size: clamp(1.15rem, 1rem + 0.65vw, 1.5rem);
    line-height: 1.25;
    color: var(--ink-2);
    padding-left: 1.15rem;
    position: relative;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--gold);
  }

  .one-dataset {
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    font-family: var(--display);
    font-variation-settings: 'opsz' 40;
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.9rem);
    color: var(--ink);
  }

  .properties {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--stone-line);
  }

  dt {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 0.6rem;
  }

  dd {
    margin: 0;
    font-size: 0.965rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 2.25rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: -0.01em;
  }

  .counts span:not(:last-child)::after {
    content: ' /';
    color: var(--stone-line);
  }

  @media (max-width: 820px) {
    .columns,
    .properties {
      grid-template-columns: 1fr;
    }
  }
</style>
