---
import { families, familyMax } from '../data/taxonomy'

const top = families.slice(0, 5)

const security = ['Data leaks', 'Prompt injection', 'Tool abuse', 'Cross-tenant access']

const reliability = [
  'Wrong action taken',
  'Off-policy behavior',
  'Instruction drift',
  'Confident wrong answers',
]

const properties = [
  { term: 'Independent', def: 'We sit outside the deal and run the attacks ourselves' },
  { term: 'Compounding', def: 'Every engagement writes back, so the next one starts ahead' },
  { term: 'Field-wide', def: 'Patterns travel between engagements. Your data stays yours' },
]
---

<section class="section" id="how-agents-fail">
  <div class="page">
    <p class="label">How agents fail</p>

    <h2>
      Every way an agent can fail, security or reliability, becomes structured
      knowledge
    </h2>

    <div class="columns">
      <div class="col">
        <h3>Security failures</h3>
        <ul>{security.map((s) => <li>{s}</li>)}</ul>
      </div>

      <div class="col">
        <h3>Reliability failures</h3>
        <ul>{reliability.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>

    <p class="one-dataset">Both live in one dataset</p>

    <figure class="corpus">
      <figcaption class="label">Where the depth sits</figcaption>
      <ul class="bars">
        {
          top.map((f) => (
            <li>
              <span class="bar-label">{f.label}</span>
              <span class="track">
                <span class="fill" style={`width:${Math.round((f.count / familyMax) * 100)}%`} />
              </span>
              <span class="bar-count tnum">{f.count}</span>
            </li>
          ))
        }
      </ul>
    </figure>

    <dl class="properties">
      {
        properties.map((p) => (
          <div>
            <dt>{p.term}</dt>
            <dd>{p.def}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.85rem, 1.2rem + 2.5vw, 3rem);
    max-width: 30ch;
    margin-block: 1.1rem clamp(2.75rem, 6vw, 4.25rem);
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 5vw, 4.5rem);
  }

  .col {
    border-top: 1px solid var(--stone-line);
    padding-top: 1.35rem;
  }

  .col h3 {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .col li {
    font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink-2);
    padding-left: 1.15rem;
    position: relative;
  }

  .col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--gold);
  }

  .one-dataset {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.035em;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    color: var(--ink);
  }

  .corpus {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--bone-lift);
    border: 1px solid var(--stone-line);
  }

  figcaption {
    padding-bottom: 1rem;
    margin-bottom: 1.35rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .bars {
    display: grid;
    gap: 0.85rem;
  }

  .bars li {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr 2.4rem;
    align-items: center;
    gap: 1rem;
  }

  .bar-label {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .track {
    height: 8px;
    background: var(--parchment);
    position: relative;
    overflow: hidden;
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: linear-gradient(to right, var(--gold) 0%, var(--gold-lift) 100%);
  }

  .bar-count {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    text-align: right;
  }

  .properties {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--stone-line);
  }

  dt {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 0.6rem;
  }

  dd {
    margin: 0;
    font-size: 0.985rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 820px) {
    .columns,
    .properties {
      grid-template-columns: 1fr;
    }
    .bars li {
      grid-template-columns: 1fr 2.4rem;
    }
    .track {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
