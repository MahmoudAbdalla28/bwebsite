---
const proof = [
  { value: '#5', scale: 'of 10,000+', label: "Lakera's Agent Breaker leaderboard" },
  { value: '94%', scale: 'attack success rate', label: 'AgentHarm, official test split' },
]
---

<section class="band">
  <div class="page grid">
    {
      proof.map((p) => (
        <article class="stat">
          <p class="value tnum">
            {p.value}
            <span class="scale">{p.scale}</span>
          </p>
          <hr class="rule" />
          <p class="label">{p.label}</p>
        </article>
      ))
    }

    <article class="stat flywheel">
      <svg viewBox="0 0 64 64" aria-hidden="true" class="wheel">
        <circle cx="32" cy="32" r="23" class="ring" />
        <circle cx="32" cy="32" r="23" class="arc" />
        <circle cx="32" cy="32" r="4.5" class="hub" />
      </svg>
      <div>
        <p class="value">Continuous</p>
        <hr class="rule" />
        <p class="label">Vulnerability research</p>
      </div>
    </article>
  </div>
</section>

<style>
  .band {
    background: var(--bone-lift);
    border-block: 1px solid var(--stone-line);
    padding-block: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  .stat {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .value {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.35rem, 1.6rem + 2.6vw, 3.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .scale {
    font-family: var(--sans);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--muted);
  }

  .label {
    color: var(--muted);
    letter-spacing: 0.14em;
  }

  /* the third proof is not a number. it is that it never stops. */
  .flywheel {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 1.15rem;
  }

  .wheel {
    width: 52px;
    height: 52px;
    flex: none;
  }

  .ring {
    fill: none;
    stroke: var(--stone-line);
    stroke-width: 2;
  }

  .arc {
    fill: none;
    stroke: var(--gold);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 46 99;
    transform-origin: 32px 32px;
    animation: spin 6s linear infinite;
  }

  .hub {
    fill: var(--gold);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .flywheel .value {
    font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.3rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .arc {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
