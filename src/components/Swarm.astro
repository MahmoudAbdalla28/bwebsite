---
// A real swarm, not a recording. Agents roam a surface, converge on a node,
// work it, and move on. New nodes appear as the surface is mapped.
//
// Perf contract, because this is the only JS on the site:
//   - one canvas, no DOM churn, no library
//   - paused when offscreen and when the tab is hidden
//   - never starts at all under prefers-reduced-motion
//   - agent count scales down on small screens
interface Props {
  mode?: 'stage' | 'ambient'
}
const { mode = 'stage' } = Astro.props
---

<div class:list={['swarm', mode]} data-mode={mode} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .swarm {
    pointer-events: none;
  }

  .swarm.stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    background: var(--bone-lift);
    border: 1px solid var(--stone-line);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 20px 54px -26px rgba(25, 23, 19, 0.3);
  }

  /* the ambient one sits behind everything, quietly */
  .swarm.ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const INK = '#f5efe2'
  const GOLD = '#d1a049'
  const BLUE = '#6fb2f0'
  const STONE = '#3a362d'
  const LABEL = 'rgba(210,201,184,0.78)'

  // real classes, so the diagram reads as data rather than decoration
  const NODES = [
    'prompt-injection', 'auth-bypass', 'cross-tenant', 'tool-abuse',
    'system-prompt', 'off-policy', 'ssrf', 'idor',
    'rce', 'instruction-drift', 'mcp-poisoning',
  ]

  class Swarm {
    constructor(root) {
      this.root = root
      this.canvas = root.querySelector('canvas')
      this.ctx = this.canvas.getContext('2d', { alpha: true })
      this.ambient = root.dataset.mode === 'ambient'
      this.running = false
      this.visible = false
      this.nodes = []
      this.agents = []
      this.t = 0
      this.resize()
      this.seed()

      this.onResize = () => this.resize()
      addEventListener('resize', this.onResize, { passive: true })

      document.addEventListener('visibilitychange', () => this.sync())

      new IntersectionObserver((es) => {
        this.visible = es[0].isIntersecting
        this.sync()
      }).observe(root)
    }

    sync() {
      const should = this.visible && !document.hidden
      if (should === this.running) return
      this.running = should
      if (should) {
        this.last = performance.now()
        this.raf = requestAnimationFrame((t) => this.frame(t))
      } else {
        cancelAnimationFrame(this.raf)
      }
    }

    resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      const r = this.root.getBoundingClientRect()
      this.w = Math.max(r.width, 1)
      this.h = Math.max(r.height, 1)
      this.canvas.width = this.w * dpr
      this.canvas.height = this.h * dpr
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    seed() {
      const small = this.w < 700
      // the ambient layer is a school and nothing else. no graph, no nodes.
      this.maxNodes = this.ambient ? 0 : small ? 6 : 11
      const nAgents = this.ambient ? (small ? 6 : 8) : small ? 10 : 22

      if (!this.ambient) for (let i = 0; i < 4; i++) this.spawnNode()

      // one slow heading the whole school shares, so it crosses the page
      this.heading = Math.random() * 6.2832

      const hx = this.w * (0.25 + Math.random() * 0.5)
      const hy = this.h * (0.25 + Math.random() * 0.5)
      for (let i = 0; i < nAgents; i++) {
        this.agents.push({
          x: this.ambient ? hx + (Math.random() - 0.5) * 90 : Math.random() * this.w,
          y: this.ambient ? hy + (Math.random() - 0.5) * 90 : Math.random() * this.h,
          vx: (Math.random() - 0.5) * 40,
          vy: (Math.random() - 0.5) * 40,
          target: (Math.random() * this.nodes.length) | 0,
          hold: Math.random() * 4,
          hue: Math.random(),
          trail: [],
        })
      }
    }

    spawnNode() {
      if (this.nodes.length >= this.maxNodes) return
      const used = new Set(this.nodes.map((n) => n.label))
      const free = NODES.filter((n) => !used.has(n))
      // pick the spot furthest from what is already placed, so the surface
      // spreads out instead of piling up in the centre
      let best = null, bestD = -1
      for (let k = 0; k < 26; k++) {
        const x = this.w * (0.1 + Math.random() * 0.72)
        const y = this.h * (0.14 + Math.random() * 0.72)
        let d = 1e9
        for (const n of this.nodes) d = Math.min(d, Math.hypot(n.x - x, n.y - y))
        if (this.nodes.length === 0) d = 1e9
        if (d > bestD) { bestD = d; best = { x, y } }
      }
      this.nodes.push({
        x: best.x, y: best.y, born: this.t, r: 0,
        label: free.length ? free[(Math.random() * free.length) | 0] : '',
        heat: 0, state: 'idle', work: 0,
      })
    }

    frame(now) {
      if (!this.running) return
      let dt = (now - this.last) / 1000
      this.last = now
      // a queued rAF from before a pause can fire with a stale timestamp,
      // which makes dt negative and walks the clock backwards
      if (!(dt > 0)) dt = 0
      if (dt > 0.05) dt = 0.05
      this.t += dt

      // the surface keeps opening up (stage only)
      if (this.nodes.length < this.maxNodes && Math.random() < dt * 0.22) {
        this.spawnNode()
      }
      // the school's heading drifts slowly, so it wanders across and back
      if (this.ambient) this.heading += (Math.random() - 0.5) * dt * 0.55

      this.step(dt)
      this.draw()
      this.raf = requestAnimationFrame((t) => this.frame(t))
    }

    step(dt) {
      const A = this.agents
      const maxV = this.ambient ? 46 : 62

      for (let i = 0; i < A.length; i++) {
        const a = A[i]
        let sx = 0, sy = 0, ax = 0, ay = 0, cx = 0, cy = 0, n = 0

        for (let j = 0; j < A.length; j++) {
          if (i === j) continue
          const b = A[j]
          const dx = b.x - a.x, dy = b.y - a.y
          const d2 = dx * dx + dy * dy
          if (d2 === 0) continue
          if (!this.ambient && d2 > 9000) continue
          n++
          ax += b.vx; ay += b.vy
          cx += b.x; cy += b.y
          const near = this.ambient ? 1500 : 620
          const push = this.ambient ? 1500 : 900
          if (d2 < near) { sx -= dx / d2 * push; sy -= dy / d2 * push }
        }

        if (n) {
          const align = this.ambient ? 2.2 : 0.6
          const cohere = this.ambient ? 1.5 : 0.22
          a.vx += ((ax / n) - a.vx) * align * dt
          a.vy += ((ay / n) - a.vy) * align * dt
          a.vx += ((cx / n) - a.x) * cohere * dt
          a.vy += ((cy / n) - a.y) * cohere * dt
        }
        a.vx += sx * dt
        a.vy += sy * dt

        if (this.ambient) {
          // no target to seek. just swim, together, in the shared heading.
          a.vx += Math.cos(this.heading) * 26 * dt
          a.vy += Math.sin(this.heading) * 26 * dt
        }

        // work a node, then go find another. this is the exploring part.
        const node = this.ambient ? null : this.nodes[a.target % this.nodes.length]
        if (node) {
          const dx = node.x - a.x, dy = node.y - a.y
          const d = Math.hypot(dx, dy) || 1
          if (d < 34) {
            a.hold -= dt
            if (a.hold <= 0) {
              a.target = (Math.random() * this.nodes.length) | 0
              a.hold = 1.6 + Math.random() * 4.5
            }
          } else {
            a.vx += (dx / d) * 52 * dt
            a.vy += (dy / d) * 52 * dt
          }
        }

        const sp = Math.hypot(a.vx, a.vy)
        if (sp > maxV) { a.vx = (a.vx / sp) * maxV; a.vy = (a.vy / sp) * maxV }

        a.x += a.vx * dt
        a.y += a.vy * dt

        if (this.ambient) {
          // handled after the loop, as a group
        } else {
          const pad = 6
          if (a.x < pad) { a.x = pad; a.vx = Math.abs(a.vx) }
          if (a.x > this.w - pad) { a.x = this.w - pad; a.vx = -Math.abs(a.vx) }
          if (a.y < pad) { a.y = pad; a.vy = Math.abs(a.vy) }
          if (a.y > this.h - pad) { a.y = this.h - pad; a.vy = -Math.abs(a.vy) }
        }
      }

      if (this.ambient) {
        let mx = 0, my = 0
        for (const a of A) { mx += a.x; my += a.y }
        mx /= A.length; my /= A.length
        const m = 90
        let ox = 0, oy = 0
        if (mx < -m) ox = this.w + 2 * m
        else if (mx > this.w + m) ox = -(this.w + 2 * m)
        if (my < -m) oy = this.h + 2 * m
        else if (my > this.h + m) oy = -(this.h + 2 * m)
        if (ox || oy) for (const a of A) { a.x += ox; a.y += oy }
      }

      for (const nd of this.nodes) {
        const age = this.t - nd.born
        nd.r = Math.max(0, Math.min(1, age / 0.9))
      }

      if (!this.ambient) {
        for (const nd of this.nodes) {
          let near = 0
          for (const a of A) if (Math.hypot(a.x - nd.x, a.y - nd.y) < 46) near++
          const want = near > 0 ? 1 : 0
          nd.heat += (want - nd.heat) * dt * 2.2
          if (near > 0) nd.work += dt * near
        }
        for (const a of A) {
          a.trail.push(a.x, a.y)
          if (a.trail.length > 26) a.trail.splice(0, 2)
        }
      }
    }

    draw() {
      const c = this.ctx
      c.clearRect(0, 0, this.w, this.h)

      // the surface being mapped. stage only, the ambient layer has no graph.
      if (!this.ambient) {
        c.strokeStyle = STONE
        c.globalAlpha = 0.5
        c.lineWidth = 1
        for (let i = 0; i < this.nodes.length; i++) {
          for (let j = i + 1; j < this.nodes.length; j++) {
            const a = this.nodes[i], b = this.nodes[j]
            if (Math.hypot(b.x - a.x, b.y - a.y) > this.w * 0.34) continue
            c.beginPath(); c.moveTo(a.x, a.y); c.lineTo(b.x, b.y); c.stroke()
          }
        }
        c.globalAlpha = 1

        // trails, so you can see where the swarm has been
        c.lineWidth = 1.4
        for (const a of this.agents) {
          const tr = a.trail
          for (let k = 2; k < tr.length; k += 2) {
            c.globalAlpha = (k / tr.length) * 0.3
            c.strokeStyle = a.hue > 0.62 ? BLUE : a.hue > 0.3 ? '#e8dfcc' : GOLD
            c.beginPath(); c.moveTo(tr[k - 2], tr[k - 1]); c.lineTo(tr[k], tr[k + 1]); c.stroke()
          }
        }
        c.globalAlpha = 1

        c.font = '500 12px "Instrument Sans Variable", system-ui, sans-serif'
        c.textBaseline = 'middle'
        for (const nd of this.nodes) {
          const col = GOLD
          const r = 4 * nd.r

          // halo grows while the swarm is working it
          const halo = 8 + nd.heat * 16
          c.beginPath(); c.arc(nd.x, nd.y, halo, 0, 6.2832)
          c.fillStyle = 'rgba(209,160,73,0.13)'
          c.fill()

          if (nd.heat > 0.05) {
            c.beginPath(); c.arc(nd.x, nd.y, halo + 4, 0, 6.2832)
            c.strokeStyle = col; c.globalAlpha = nd.heat * 0.5; c.lineWidth = 1
            c.stroke(); c.globalAlpha = 1
          }

          c.beginPath(); c.arc(nd.x, nd.y, r, 0, 6.2832)
          c.fillStyle = col; c.fill()

          if (nd.label && nd.r > 0.55) {
            c.globalAlpha = (nd.r - 0.55) / 0.45
            c.fillStyle = 'rgba(226,219,204,0.92)'
            c.fillText(nd.label, nd.x + 13, nd.y)
            c.globalAlpha = 1
          }
        }
      }

      for (const a of this.agents) {
        const ang = Math.atan2(a.vy, a.vx)
        const s = this.ambient ? 3.1 : 5.4
        c.save()
        c.translate(a.x, a.y)
        c.rotate(ang)
        c.beginPath()
        c.moveTo(s * 1.7, 0)
        c.lineTo(-s, s * 0.72)
        c.lineTo(-s * 0.4, 0)
        c.lineTo(-s, -s * 0.72)
        c.closePath()
        c.fillStyle = a.hue > 0.62 ? BLUE : a.hue > 0.3 ? INK : GOLD
        c.globalAlpha = this.ambient ? 0.5 : 0.9
        c.fill()
        c.restore()
      }
      c.globalAlpha = 1
    }
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const el of document.querySelectorAll('.swarm')) new Swarm(el)
  }
</script>
