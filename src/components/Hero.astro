---
// Architecture borrowed from the sites that actually hold attention:
// a full-bleed environment you are standing inside, one claim, one action,
// and the product bleeding up into the scene and cut off by the fold, so the
// only way to finish the picture is to scroll.
---

<section class="hero">
  <div class="sky" aria-hidden="true"></div>
  <div class="ridge" aria-hidden="true"></div>

  <div class="page inner">
    <p class="label rise d1">Independent adversarial testing for AI agents</p>

    <h1 class="rise d2">
      We know how AI agents fail.<br />
      <span class="turn">So you can trust the ones you ship.</span>
    </h1>

    <p class="lede rise d3">
      We attack live agents across security and reliability, and turn every
      finding into an independent, compounding record of how agents break.
    </p>

    <div class="actions rise d4">
      <a class="btn btn-primary" href="/contact">Book a scoping call</a>
      <a class="btn btn-quiet" href="#how-agents-fail">See how agents fail</a>
    </div>
  </div>

  <!-- the product, cut off by the fold -->
  <div class="stage rise d5">
    <div class="frame">
      <video
        class="reel"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/assets/shot-cortex.webp"
        width="1440"
        height="900"
        aria-label="The corpus being browsed: vulnerability classes, then the OWASP LLM Top 10."
      >
        <source src="/assets/cortex-tour.webm" type="video/webm" />
        <source src="/assets/cortex-tour.mp4" type="video/mp4" />
      </video>
      <img
        class="still"
        src="/assets/shot-cortex.webp"
        width="1800"
        height="1125"
        alt="The Bastion corpus: 18,158 items and 18,531 links."
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(2.5rem, 5vw, 4.25rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  /* the environment. light breaking over a ridge, everything below it in haze */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        58% 44% at 50% -4%,
        rgba(255, 251, 240, 0.98) 0%,
        rgba(253, 240, 210, 0.7) 38%,
        rgba(246, 241, 232, 0) 74%
      ),
      radial-gradient(
        30% 26% at 50% -8%,
        rgba(226, 172, 78, 0.4) 0%,
        rgba(226, 172, 78, 0) 72%
      ),
      linear-gradient(to bottom, #f3ecdf 0%, #f7f2e9 46%, #fbf8f2 100%);
  }

  /* a single ridge line, the citadel silhouette reduced to one gesture */
  .ridge {
    position: absolute;
    left: -4%;
    right: -4%;
    top: 38%;
    height: 46%;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(203, 191, 169, 0.34),
      rgba(203, 191, 169, 0)
    );
    clip-path: polygon(
      0% 100%,
      0% 62%,
      13% 44%,
      22% 56%,
      34% 22%,
      41% 38%,
      52% 8%,
      63% 34%,
      74% 20%,
      84% 46%,
      93% 36%,
      100% 58%,
      100% 100%
    );
  }

  .inner {
    position: relative;
  }

  .label {
    display: inline-block;
  }

  h1 {
    font-size: clamp(2.35rem, 1.1rem + 4.6vw, 4.35rem);
    margin-block: 1.4rem 0;
    margin-inline: auto;
    max-width: 21ch;
  }

  .turn {
    display: block;
    text-wrap: balance;
    color: var(--ink-2);
  }

  .lede {
    margin: 1.6rem auto 0;
    max-width: 54ch;
    text-align: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: clamp(1.9rem, 3.5vw, 2.6rem);
  }

  /* the stage crops the product against the fold */
  .stage {
    margin-top: clamp(2.25rem, 4.5vw, 3.25rem);
    padding-inline: var(--gutter);
    overflow: visible;
  }

  .frame {
    max-width: 1080px;
    margin-inline: auto;
    border: 1px solid var(--stone-line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 -1px 0 rgba(255, 255, 255, 0.7) inset,
      0 26px 70px -28px rgba(25, 23, 19, 0.4);
  }

  .frame :is(video, img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame .still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reel {
      display: none;
    }
    .frame .still {
      display: block;
    }
  }

  @media (max-width: 720px) {
    .stage {
    }
  }
</style>
