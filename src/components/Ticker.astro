---
// A moving strip of the actual failure classes. It exists to catch the eye at
// the moment the dark hero hands over to the page, and it happens to be the
// taxonomy, so the attention it buys is spent on the right thing.
const classes = [
  'prompt injection',
  'cross-tenant access',
  'auth bypass',
  'tool abuse',
  'system-prompt extraction',
  'off-policy action',
  'markdown link exfiltration',
  'remote code execution',
  'instruction drift',
  'server-side request forgery',
  'agent-runtime exfiltration',
  'unbounded generation',
  'MCP tool poisoning',
  'confident wrong answers',
]
const lane = [...classes, ...classes]
---

<div class="ticker" aria-hidden="true">
  <div class="lane">
    {lane.map((c) => <span class="item">{c}<i class="dot"></i></span>)}
  </div>
</div>

<p class="sr">
  Failure classes Bastion tests for, including {classes.slice(0, 6).join(', ')}.
</p>

<style>
  .ticker {
    overflow: hidden;
    background: var(--ink);
    border-block: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 0.85rem;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
  }

  .lane {
    display: flex;
    width: max-content;
    animation: slide 46s linear infinite;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  .ticker:hover .lane {
    animation-play-state: paused;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
    font-size: 0.9rem;
    letter-spacing: -0.005em;
    color: rgba(246, 241, 232, 0.62);
  }

  .dot {
    width: 4px;
    height: 4px;
    background: var(--gold);
    border-radius: 50%;
    flex: none;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .lane {
      animation: none;
    }
  }
</style>
