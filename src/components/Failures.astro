---
import { failures } from '../data/failures'
---

<section class="feed">
  <div class="page">
    <div class="head">
      <p class="label">Agents are failing in public</p>
      <p class="note">every one of these is somebody’s shipped product</p>
    </div>

    <ol>
      {
        failures.map((f, i) => (
          <li>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <a href={f.href} target="_blank" rel="noopener noreferrer">
              <span class="who">{f.who}</span>
              <span class="what">{f.what}</span>
            </a>
            <span class="meta">
              {f.when}
              <i>·</i>
              {f.source}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .feed {
    background: var(--panel);
    border-block: 1px solid var(--stone-line);
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .note {
    font-size: 0.86rem;
    color: var(--muted);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: baseline;
    gap: 0 1.1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid rgba(54, 51, 43, 0.6);
  }

  li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .idx {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--gold);
  }

  a {
    text-decoration: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.7rem;
  }

  .who {
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease, color 150ms ease;
  }

  a:hover .who {
    color: var(--gold-text);
    border-bottom-color: var(--gold);
  }

  .what {
    font-size: 0.96rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .meta {
    font-size: 0.76rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .meta i {
    font-style: normal;
    color: var(--stone-line);
    padding-inline: 0.35rem;
  }

  @media (max-width: 720px) {
    li {
      grid-template-columns: 1.6rem 1fr;
      gap: 0.3rem 0.8rem;
    }
    .meta {
      grid-column: 2;
    }
  }
</style>
