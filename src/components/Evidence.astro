---
import { report } from '../data/report'

const sevMax = Math.max(...report.severity.map((s) => s.count))
---

<section class="section" id="evidence">
  <div class="page split">
    <div class="pitch">
      <p class="label">For teams shipping AI into enterprises</p>

      <h2>Your enterprise customers will make you prove your agent is safe.</h2>

      <p class="lede">
        We produce the evidence that clears their review. Written for your
        customer's security reviewer, in the language their frameworks use.
      </p>

      <ul class="points">
        <li>Every finding carries the transcript that produced it</li>
        <li>Severity and business impact on each one</li>
        <li>Mapped to the frameworks the reviewer already asks about</li>
        <li>Re-run on every deployment, so the evidence stays current</li>
      </ul>

      <a class="btn btn-primary" href="/contact">Book a scoping call</a>
    </div>

    <!-- a real report from the product, rendered as a static artifact -->
    <figure class="doc">
      <header class="doc-head">
        <div>
          <p class="doc-id tnum">{report.id}</p>
          <p class="doc-sub muted">{report.subject} / {report.agent}</p>
        </div>
        <p class="chip">{report.posture}</p>
      </header>

      <p class="doc-period muted tnum">{report.period}</p>

      <div class="totals tnum">
        {
          report.totals.map((t) => (
            <div class="total">
              <span class="total-v">{t.value}</span>
              <span class="total-l">{t.label}</span>
            </div>
          ))
        }
      </div>

      <div class="block">
        <p class="block-head">Findings by severity</p>
        <ul class="sev tnum">
          {
            report.severity.map((s) => (
              <li>
                <span class="sev-l">{s.level}</span>
                <span class="sev-track">
                  <span
                    class={`sev-fill s-${s.level.toLowerCase()}`}
                    style={`width:${Math.round((s.count / sevMax) * 100)}%`}
                  />
                </span>
                <span class="sev-c">{s.count}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="block">
        <p class="block-head">Selected findings</p>
        <ul class="finds">
          {
            report.findings.map((f) => (
              <li>
                <span class={`tag t-${f.severity.toLowerCase()}`}>{f.severity}</span>
                <span class="find-t">{f.title}</span>
                <span class="find-r muted">{f.ref}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <footer class="doc-foot">
        {report.frameworks.map((f) => <span class="fw">{f}</span>)}
      </footer>

      <figcaption class="muted">Sample report. Demo tenant.</figcaption>
    </figure>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: start;
  }

  h2 {
    font-size: clamp(1.75rem, 1.15rem + 2.2vw, 2.7rem);
    margin-block: 1.1rem 1.5rem;
    max-width: 18ch;
  }

  .points {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .points li {
    font-size: 0.965rem;
    line-height: 1.55;
    color: var(--ink-2);
    padding-left: 1.5rem;
    position: relative;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
  }

  .pitch .btn {
    margin-top: 2rem;
  }

  /* ---------- the report artifact ---------- */

  .doc {
    margin: 0;
    background: var(--bone-lift);
    border: 1px solid var(--stone-line);
    padding: clamp(1.35rem, 2.5vw, 1.9rem);
    box-shadow: 0 1px 0 var(--stone-line), 14px 14px 0 -1px var(--parchment);
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .doc-id {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .doc-sub {
    font-size: 0.83rem;
    margin-top: 0.2rem;
  }

  .chip {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-text);
    border: 1px solid var(--gold);
    padding: 0.24rem 0.5rem;
    white-space: nowrap;
  }

  .doc-period {
    font-family: var(--mono);
    font-size: 0.75rem;
    margin-top: 0.75rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .totals {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .total {
    display: grid;
    gap: 0.15rem;
  }

  .total-v {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.32rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .total-l {
    font-size: 0.68rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .block {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .block-head {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.85rem;
  }

  .sev,
  .finds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .sev li {
    display: grid;
    grid-template-columns: 4.4rem 1fr 1.3rem;
    align-items: center;
    gap: 0.7rem;
  }

  .sev-l {
    font-size: 0.78rem;
    color: var(--ink-2);
  }

  .sev-track {
    height: 6px;
    background: var(--parchment);
    position: relative;
    overflow: hidden;
  }

  .sev-fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--gold);
  }

  .s-critical { background: #8c2f1d; }
  .s-high { background: #b4632a; }
  .s-medium { background: var(--gold); }
  .s-low { background: var(--stone); }

  .sev-c {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--muted);
    text-align: right;
  }

  .finds li {
    display: grid;
    grid-template-columns: 4.6rem 1fr;
    gap: 0.15rem 0.7rem;
    align-items: baseline;
  }

  .tag {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.17rem 0.35rem;
    text-align: center;
    color: var(--bone-lift);
  }

  .t-critical { background: #8c2f1d; }
  .t-high { background: #b4632a; }
  .t-medium { background: var(--gold); }

  .find-t {
    font-size: 0.86rem;
    color: var(--ink);
    line-height: 1.35;
  }

  .find-r {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .doc-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.15rem;
  }

  .fw {
    font-size: 0.7rem;
    color: var(--ink-2);
    border: 1px solid var(--stone-line);
    padding: 0.24rem 0.5rem;
  }

  figcaption {
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
    .totals {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .doc {
      box-shadow: none;
    }
  }
</style>
