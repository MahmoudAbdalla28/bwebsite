---
// Real dispersion geometry. The beam strikes the left face, bends inside the
// glass, exits the right face, and opens into one continuous spectrum that
// widens with distance. The bands are our failure classes, with real depth.
import { families } from '../data/taxonomy'

const bands = families.slice(0, 7)

// the glass
const APEX = [452, 150]
const BL = [352, 344]
const BR = [552, 344]

// where the beam meets it, and where it leaves
const IN = [402, 247]
const OUT = [512, 276]

// the fan
const FAR = 1044
const TOP_Y = 232
const BOT_Y = 556
const step = (BOT_Y - TOP_Y) / bands.length
---

<figure class="prism">
  <svg
    viewBox="0 0 1200 620"
    role="img"
    aria-label="A prism splitting one beam into the failure classes Bastion tracks"
  >
    <defs>
      <linearGradient id="inbeam" x1="0" x2="1">
        <stop offset="0" stop-color="#fff8e8" stop-opacity="0.05" />
        <stop offset="1" stop-color="#fffdf6" stop-opacity="1" />
      </linearGradient>

      <!-- dispersion runs across the fan, not along it -->
      <linearGradient
        id="spectrum"
        gradientUnits="userSpaceOnUse"
        x1={FAR}
        y1={TOP_Y}
        x2={FAR}
        y2={BOT_Y}
      >
        <stop offset="0" stop-color="#f0c268" />
        <stop offset="0.17" stop-color="#d9a441" />
        <stop offset="0.34" stop-color="#b6a557" />
        <stop offset="0.5" stop-color="#7ba883" />
        <stop offset="0.66" stop-color="#4f93c4" />
        <stop offset="0.83" stop-color="#3f8fe8" />
        <stop offset="1" stop-color="#9ad0f7" />
      </linearGradient>

      <linearGradient id="fade" gradientUnits="userSpaceOnUse" x1={OUT[0]} x2={FAR}>
        <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
        <stop offset="0.55" stop-color="#fff" stop-opacity="0.55" />
        <stop offset="1" stop-color="#fff" stop-opacity="0.16" />
      </linearGradient>

      <mask id="fanFade">
        <polygon
          points={`${OUT[0]},${OUT[1]} ${FAR},${TOP_Y} ${FAR},${BOT_Y}`}
          fill="url(#fade)"
        />
      </mask>

      <linearGradient id="glass" x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0" stop-color="#fdf8ec" stop-opacity="0.22" />
        <stop offset="0.5" stop-color="#fdf8ec" stop-opacity="0.06" />
        <stop offset="1" stop-color="#fdf8ec" stop-opacity="0.14" />
      </linearGradient>

      <filter id="soft" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
      <filter id="tight" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="2.4" />
      </filter>
    </defs>

    <g class="inb">
      <line
        x1="24" y1="232" x2={IN[0]} y2={IN[1]}
        stroke="url(#inbeam)" stroke-width="20" filter="url(#soft)" opacity="0.5"
      />
      <line x1="24" y1="232" x2={IN[0]} y2={IN[1]} stroke="url(#inbeam)" stroke-width="4" />
      <text x="24" y="212" class="inlbl">every run, every target</text>
    </g>

    <g class="fan" mask="url(#fanFade)">
      <polygon
        points={`${OUT[0]},${OUT[1]} ${FAR},${TOP_Y} ${FAR},${BOT_Y}`}
        fill="url(#spectrum)" filter="url(#soft)" opacity="0.55"
      />
      <polygon
        points={`${OUT[0]},${OUT[1]} ${FAR},${TOP_Y} ${FAR},${BOT_Y}`}
        fill="url(#spectrum)" filter="url(#tight)" opacity="0.9"
      />
    </g>

    <polygon
      points={`${APEX[0]},${APEX[1]} ${BR[0]},${BR[1]} ${BL[0]},${BL[1]}`}
      fill="url(#glass)"
      stroke="rgba(253,248,236,0.5)"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <line
      x1={IN[0]} y1={IN[1]} x2={OUT[0]} y2={OUT[1]}
      stroke="#fffdf6" stroke-width="3" opacity="0.95"
    />
    <circle cx={IN[0]} cy={IN[1]} r="26" fill="#fff3d4" opacity="0.16" filter="url(#soft)" />

    {
      bands.map((b, i) => {
        const y = TOP_Y + step * (i + 0.5)
        return (
          <g class="lb" style={`--i:${i}`}>
            <line
              x1={FAR} y1={y} x2={FAR + 18} y2={y}
              stroke="rgba(245,239,226,0.28)" stroke-width="1"
            />
            <text x={FAR + 28} y={y - 3} class="lbl">{b.label.toLowerCase()}</text>
            <text x={FAR + 28} y={y + 14} class="cnt">{b.count}</text>
          </g>
        )
      })
    }
  </svg>
</figure>

<style>
  .prism {
    margin: 0;
    width: 100%;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .lbl {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.015em;
    fill: rgba(245, 239, 226, 0.92);
  }

  .cnt {
    font-family: var(--sans);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    fill: rgba(245, 239, 226, 0.4);
  }

  .inlbl {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    fill: rgba(245, 239, 226, 0.38);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fan {
      opacity: 0;
      animation: open 900ms cubic-bezier(0.2, 0.8, 0.3, 1) 420ms forwards;
    }
    .lb {
      opacity: 0;
      animation: arrive 500ms ease-out forwards;
      animation-delay: calc(880ms + var(--i) * 70ms);
    }
  }

  @keyframes open {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes arrive {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 760px) {
    .lbl { font-size: 19px; }
    .cnt { font-size: 14px; }
    .inlbl { font-size: 14px; }
  }
</style>
